{
  "version": 2,
  "builds": [
    { "src": "website/static/**", "use": "@vercel/static" },
    { "src": "media/**", "use": "@vercel/static" },
    { "src": "mysite/wsgi.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/website/static/$1" },
    { "src": "/media/(.*)", "dest": "/media/$1" },
    { "src": "/(.*)", "dest": "mysite/wsgi.py" }
  ]
}
